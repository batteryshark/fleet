#!/usr/bin/env python3
"""Stand-in for /bin/launchctl used by the tests. State lives in $FAKE_LAUNCHCTL_STATE (JSON)."""
import json, os, plistlib, sys

path = os.environ["FAKE_LAUNCHCTL_STATE"]
try:
    with open(path) as f:
        st = json.load(f)
except (OSError, ValueError):
    st = {"loaded": {}, "disabled": [], "calls": []}
args = sys.argv[1:]
st["calls"].append(args)
rc = 0


def label_of(t):
    return t.split("/", 2)[-1]


cmd = args[0] if args else ""
if cmd == "print":
    lab = label_of(args[1])
    if lab in st["loaded"]:
        pid = st["loaded"][lab]
        print("%s = {\n\tstate = %s\n%s}" % (args[1], "running" if pid else "waiting",
                                             "\tpid = %d\n" % pid if pid else ""))
    else:
        rc = 113
elif cmd == "bootstrap":
    with open(args[2], "rb") as f:
        lab = plistlib.load(f)["Label"]
    if lab in st["disabled"]:
        sys.stderr.write("Bootstrap failed: 5: Input/output error\n"); rc = 5
    elif lab in st["loaded"]:
        rc = 5
    else:
        st["loaded"][lab] = 0
elif cmd == "bootout":
    lab = label_of(args[1])
    rc = 0 if st["loaded"].pop(lab, None) is not None else 3
elif cmd == "enable":
    lab = label_of(args[1])
    st["disabled"] = [x for x in st["disabled"] if x != lab]
elif cmd == "disable":
    lab = label_of(args[1])
    if lab not in st["disabled"]:
        st["disabled"].append(lab)
elif cmd == "kickstart":
    lab = label_of(args[-1])
    if lab in st["loaded"]:
        st["loaded"][lab] = 4242
    else:
        rc = 113
elif cmd == "list":
    print("PID\tStatus\tLabel")
    for lab, pid in st["loaded"].items():
        print("%s\t0\t%s" % (pid or "-", lab))
with open(path, "w") as f:
    json.dump(st, f)
sys.exit(rc)
